# Скопіюйте в .env і заповніть. .env у .gitignore - у git не потрапляє.

# Live-гонка (WS /ws/live): логін і пароль платної підписки OpenF1 (Sponsor,
# €9.90/міс, https://openf1.org). Без них live вимкнено, replay працює й так.
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Хвилинний ліміт запитів OpenF1: 30 без підписки (за замовчуванням 28 із
# запасом), 60 з підпискою - тоді постав 58.
# OPENF1_PER_MINUTE=58

# Адреса фронтенду для CORS (у проді - домен фронта).
# FRONTEND_ORIGIN=http://localhost:5173
